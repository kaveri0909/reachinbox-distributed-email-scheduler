# ReachInbox Distributed Email Scheduler Environment Configuration

# Server Port
PORT=3000
NODE_ENV=development

# Application Base URL
APP_URL="http://localhost:3000"

# PostgreSQL Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://reachinbox:reachinbox_secure_pass@localhost:5432/reachinbox_scheduler?schema=public"

# Redis Connection (Required for BullMQ & Atomic Lua Rate Limiting)
REDIS_URL="redis://localhost:6379"

# Elasticsearch Connection (Required for Full-Text Search)
ELASTICSEARCH_URL="http://localhost:9200"
# ELASTICSEARCH_API_KEY="" # Optional API Key

# SMTP Configuration (Required for Email Delivery)
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ReachInbox Scheduler <scheduler@reachinbox.ai>"

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Slack Notifications & OAuth
SLACK_WEBHOOK_URL=""
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""

# JWT Authentication
JWT_SECRET="reachinbox_super_secret_jwt_key_at_least_32_characters"
